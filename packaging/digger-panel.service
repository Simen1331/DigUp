# Digger's search panel, kept in memory so it shows in a moment. Installed by hand (until the PKGBUILD does it):
#   cargo install --path crates/digger-panel
#   cp packaging/digger-panel.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now digger-panel
[Unit]
Description=Digger's search panel
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.cargo/bin/digger-panel --hidden
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
