// Digger in Waybar: add "custom/digger" to a modules list in ~/.config/waybar/config.jsonc, and this block beside the
// other modules. It shows how far indexing has got while it runs, and hides when all is well.
"custom/digger": {
  "exec": "digger status --waybar --follow",
  "return-type": "json",
  "restart-interval": 5,
  "on-click": "digger-panel --toggle",
  "on-click-middle": "digger pause --toggle",
  "tooltip": true
}
