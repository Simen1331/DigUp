// ShowMe in Waybar: add "custom/showme" to a modules list in ~/.config/waybar/config.jsonc, and this block beside the
// other modules. It shows how far indexing has got while it runs, and hides when all is well.
"custom/showme": {
  "exec": "showme status --waybar --follow",
  "return-type": "json",
  "restart-interval": 5,
  "on-click": "showme-panel --toggle",
  "on-click-middle": "showme pause --toggle",
  "tooltip": true
}
